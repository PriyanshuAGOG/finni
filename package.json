{
  "name": "nirog-research-os",
  "version": "1.0.0",
  "private": true,
  "description": "Nirog Bhoomi Research OS - AI-native research knowledge management platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed": "tsx scripts/seed.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "appwrite:provision": "tsx scripts/appwrite-provision.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:list-users": "tsx scripts/list-users.ts",
    "db:list-api-clients": "tsx scripts/list-api-clients.ts",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "jsdom": "^25.0.1",
    "next": "^15.1.6",
    "node-appwrite": "^27.1.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
