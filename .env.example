# =====================================================================
# Nirog Bhoomi Research OS -- environment configuration
#
# Copy to .env for local development (`cp .env.example .env`) and fill
# in real values for anything you're actually exercising. Every value
# here has a safe local-dev default in src/lib/env.ts except where noted
# REQUIRED.
# =====================================================================

NODE_ENV=development

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# REQUIRED. The application connects as a role WITHOUT superuser or table
# ownership, so row-level security actually applies to it. See
# docs/deployment.md for how to create this role.
DATABASE_URL=postgres://nirog_app:nirog_app_dev@localhost:5432/nirog_research

# Used only by `npm run db:migrate` / `npm run db:reset`, which need
# schema-owner privileges the app role deliberately lacks. Falls back to
# DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nirog_research

DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=nbros_session
SESSION_TTL_HOURS=720

# 32-byte key (hex or base64) used to encrypt stored integration
# credentials. REQUIRED before any integration credential is stored.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------
# "deterministic" needs no key and runs the whole pipeline offline --
# useful for local dev, CI, and this evaluation. Use "anthropic" or
# "openai" for production-quality enrichment and synthesis.
AI_PROVIDER=deterministic
AI_API_KEY=
AI_BASE_URL=

AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_EXTRACTION=claude-sonnet-5
AI_MODEL_SYNTHESIS=claude-opus-5
AI_MODEL_EMBEDDING=text-embedding-3-small

# Embeddings are configured separately since Anthropic does not serve an
# embeddings endpoint -- pair AI_PROVIDER=anthropic with
# AI_EMBEDDING_PROVIDER=openai in production.
AI_EMBEDDING_PROVIDER=deterministic
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------
# External research
# ---------------------------------------------------------------------
# PubMed search works with no key. Add a general web provider for wider
# external discovery coverage.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
# "local" writes to STORAGE_LOCAL_PATH -- fine for dev, not for a
# serverless deploy (no persistent disk). "appwrite" stores source
# snapshots as files in an Appwrite Storage bucket; the relational data
# itself stays on Postgres regardless of this setting.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Required when STORAGE_DRIVER=appwrite. Create an API key in the
# Appwrite console (Project Settings -> API Keys) with scopes
# files.read, files.write, buckets.read, buckets.write, then run
# `npm run appwrite:provision` once to create the bucket.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=research_os_sources

# ---------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------
# Limits and safety thresholds
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
MAX_INGEST_BATCH_SIZE=25
MAX_BULK_OPERATION_SIZE=200
MAX_SYNTHESIS_SOURCES=30
MAX_SOURCE_TEXT_BYTES=120000
MAX_UPLOAD_BYTES=52428800

CATEGORY_ARCHIVE_CONFIRM_THRESHOLD=5
BULK_CONFIRM_THRESHOLD=10
CONFIRMATION_TTL_MINUTES=15
